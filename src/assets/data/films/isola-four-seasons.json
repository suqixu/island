  "captions": [
    {
      "start": 0,
      "end": 7,
      "text": "浮屿 · ISOLA",
      "style": "title"
    },
    {
      "start": 8,
      "end": 14,
      "text": "把片刻，交给自然。",
      "style": "body"
    },
    {
      "start": 15,
      "end": 24,
      "text": "沿着海风，慢慢靠岸。",
      "style": "body"
    },
    {
      "start": 27,
      "end": 39,
      "text": "水色深处，自有生灵往来。",
      "style": "body"
    },
    {
      "start": 46,
      "end": 54,
      "text": "礁岸之外，海流轻轻呼吸。",
      "style": "body"
    },
    {
      "start": 57,
      "end": 71,
      "text": "一朵花，也是一处值得停留的风景。",
      "style": "body"
    },
    {
      "start": 75,
      "end": 83,
      "text": "每一次相遇，都有不同的节奏。",
      "style": "body"
    },
    {
      "start": 88,
      "end": 102,
      "text": "循着山径，看林间的日常。",
      "style": "body"
    },
    {
      "start": 116,
      "end": 122,
      "text": "春生",
      "style": "body"
    },
    {
      "start": 123,
      "end": 130,
      "text": "夏雨",
      "style": "body"
    },
    {
      "start": 131,
      "end": 137,
      "text": "秋色",
      "style": "body"
    },
    {
      "start": 138,
      "end": 145,
      "text": "冬雪",
      "style": "body"
    },
    {
      "start": 148,
      "end": 159,
      "text": "灯塔守着落日，海面接住余晖。",
      "style": "body"
    },
    {
      "start": 166,
      "end": 174,
      "text": "灯火亮起，小岛换一种呼吸。",
      "style": "body"
    },
    {
      "start": 174,
      "end": 178,
      "text": "草间微光，与你偶遇。",
      "style": "body"
    },
    {
      "start": 178,
      "end": 180,
      "text": "浮屿 · 在自然里，慢下来",
      "style": "ending"
    }
  ]
}
