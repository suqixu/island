  "captions": [
    {
      "start": 1,
      "end": 7,
      "text": "浮屿 · 渔舟唱晚",
      "style": "title"
    },
    {
      "start": 8,
      "end": 13,
      "text": "一海碎金，留住将晚的天光。",
      "style": "body"
    },
    {
      "start": 16,
      "end": 23,
      "text": "归鸟向晚，渔舟缓缓。",
      "style": "body"
    },
    {
      "start": 29,
      "end": 37,
      "text": "鱼跃成银，浪花替海轻唱。",
      "style": "body"
    },
    {
      "start": 43,
      "end": 49,
      "text": "云霞渐红，落日慢慢归海。",
      "style": "body"
    },
    {
      "start": 52,
      "end": 59,
      "text": "日已落，月未起。\n天地之间，只余宁静。",
      "style": "ending"
    }
  ]
